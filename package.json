{
  "name": "tokenlens-monitor",
  "displayName": "TokenLens — Agent & LLM Usage Monitor",
  "description": "监控 Claude Code、Codex、Copilot 等 AI 编程工具与 DeepSeek/OpenAI/Anthropic 等 LLM API 的 Token、费用、余额和缓存命中。状态栏 + 可视化面板。",
  "version": "0.1.0",
  "publisher": "tokenlens",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "tokenLens.showDashboard",
        "title": "TokenLens: 打开用量面板",
        "icon": "$(graph)"
      },
      {
        "command": "tokenLens.refreshBalance",
        "title": "TokenLens: 刷新余额和用量",
        "icon": "$(refresh)"
      },
      {
        "command": "tokenLens.toggleMonitor",
        "title": "TokenLens: 开启/暂停监控",
        "icon": "$(debug-pause)"
      },
      {
        "command": "tokenLens.resetSession",
        "title": "TokenLens: 重置本次会话统计",
        "icon": "$(trash)"
      },
      {
        "command": "tokenLens.exportReport",
        "title": "TokenLens: 导出用量报告",
        "icon": "$(export)"
      }
    ],
    "configuration": {
      "title": "TokenLens",
      "properties": {
        "tokenLens.apiKey": {
          "type": "string",
          "default": "",
          "description": "DeepSeek API Key。配置后可查询平台余额。不配置也能通过 Agent/API 请求拦截自动追踪用量。"
        },
        "tokenLens.providers": {
          "type": "array",
          "default": [
            {
              "name": "DeepSeek",
              "type": "api",
              "apiBase": "https://api.deepseek.com",
              "models": ["deepseek-chat", "deepseek-reasoner"]
            }
          ],
          "description": "要监控的 LLM 提供商列表。支持 OpenAI 兼容 API（硅基流动、智谱、通义千问等）。"
        },
        "tokenLens.apiBase": {
          "type": "string",
          "default": "https://api.deepseek.com",
          "description": "DeepSeek API 基础 URL。如使用代理或兼容端点可在此修改。"
        },
        "tokenLens.balanceCheckInterval": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 60,
          "description": "余额自动查询间隔（分钟）。"
        },
        "tokenLens.usagePollInterval": {
          "type": "number",
          "default": 30,
          "minimum": 10,
          "maximum": 300,
          "description": "用量数据轮询间隔（秒）。仅 API 模式生效。"
        },
        "tokenLens.interceptEnabled": {
          "type": "boolean",
          "default": true,
          "description": "启用 Agent/API 请求拦截。自动捕获 VS Code 扩展发往 LLM API 的请求，实时追踪用量，无需 API Key。"
        },
        "tokenLens.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "VSCode 启动时自动开始监控。"
        },
        "tokenLens.pricing": {
          "type": "object",
          "default": {
            "deepseek-chat": { "input": 1.0, "output": 2.0, "currency": "CNY", "cacheHitDiscount": 0.1 },
            "deepseek-reasoner": { "input": 4.0, "output": 16.0, "currency": "CNY" }
          },
          "description": "自定义模型定价（每百万 tokens）。格式: {\"模型名\": {\"input\": 输入价格, \"output\": 输出价格, \"currency\": \"CNY\", \"cacheHitDiscount\": 缓存折扣比例}}"
        },
        "tokenLens.contextWindowSizes": {
          "type": "object",
          "default": {
            "deepseek-chat": 131072,
            "deepseek-reasoner": 65536,
            "gpt-4o": 131072,
            "gpt-4o-mini": 131072,
            "claude-3.5-sonnet": 200000
          },
          "description": "各模型的上下文窗口大小（tokens）。用于计算上下文窗口占比。"
        },
        "tokenLens.contextWarnThreshold": {
          "type": "number",
          "default": 70,
          "minimum": 0,
          "maximum": 100,
          "description": "上下文窗口占比警告阈值（%）。超过此值状态栏变色提示。"
        },
        "tokenLens.contextCriticalThreshold": {
          "type": "number",
          "default": 85,
          "minimum": 0,
          "maximum": 100,
          "description": "上下文窗口占比严重告警阈值（%）。超过此值状态栏变红。"
        },
        "tokenLens.costAlertThreshold": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "description": "会话费用告警阈值（元）。超过此值弹出通知提醒。设为 0 关闭告警。"
        },
        "tokenLens.statusBarDisplay": {
          "type": "string",
          "default": "cost-tokens-cache",
          "enum": ["cost-only", "cost-tokens", "cost-tokens-cache", "cost-tokens-cache-context"],
          "description": "状态栏显示内容。cost-only: 仅费用; cost-tokens: 费用+Token; cost-tokens-cache: 费用+Token+缓存命中; cost-tokens-cache-context: 全部信息含上下文占比。"
        },
        "tokenLens.showNotificationOnUpdate": {
          "type": "boolean",
          "default": false,
          "description": "余额或用量更新时弹出通知。"
        },
        "tokenLens.localMonitorPaths": {
          "type": "array",
          "default": [],
          "description": "额外本地缓存/日志文件路径（glob 格式）。用于解析 Continue/Cline/Aider 等工具的用量日志。"
        },
        "tokenLens.maxLogEntries": {
          "type": "number",
          "default": 500,
          "minimum": 50,
          "maximum": 10000,
          "description": "最多保留的请求日志条数。"
        },
        "tokenLens.showCacheHitRate": {
          "type": "boolean",
          "default": true,
          "description": "在状态栏和面板中显示缓存命中率。DeepSeek 缓存命中时输入价格仅 ¥0.1/M tokens。"
        },
        "tokenLens.theme": {
          "type": "string",
          "default": "auto",
          "enum": ["auto", "dark", "light"],
          "description": "仪表板面板主题。auto 跟随 VSCode 主题。"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tokenlens-monitor-sidebar",
          "title": "TokenLens",
          "icon": "$(dashboard)"
        }
      ]
    },
    "views": {
      "tokenlens-monitor-sidebar": [
        {
          "type": "webview",
          "id": "tokenLens.dashboard",
          "name": "用量面板"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/vscode": "^1.82.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  }
}
